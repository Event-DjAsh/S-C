rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Published website content: readable and writable by admin and live site
    match /site_content/{contentId} {
      allow read, write: if isValidId(contentId);
    }

    // Individual gallery events for robust photo sets
    match /site_gallery/{eventId} {
      allow read, write: if isValidId(eventId);
    }

    // Customer lead inquiries: anyone can submit quote requests; read/update for management
    match /inquiries/{inquiryId} {
      allow read, write: if isValidId(inquiryId);
    }
  }
}
